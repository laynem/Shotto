<Window x:Class="Shotto.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Shotto" Width="1000" Height="700" MinWidth="720" MinHeight="420"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="ToolButton" TargetType="RadioButton" BasedOn="{StaticResource SubtleButton}">
            <Setter Property="GroupName" Value="Tool" />
            <Setter Property="Width" Value="40" />
            <Setter Property="Margin" Value="0,0,2,0" />
        </Style>
        <Style x:Key="BarButton" TargetType="Button" BasedOn="{StaticResource SubtleButton}">
            <Setter Property="Margin" Value="0,0,2,0" />
        </Style>
        <Style x:Key="BarDivider" TargetType="Rectangle">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Margin" Value="8,0" />
            <Setter Property="Fill" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
        </Style>
        <Style x:Key="Flyout" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SurfaceStrokeColorFlyoutBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="12,4,12,16" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.22" />
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Command bar -->
        <Border Padding="10,6" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource BarButton}" Click="Copy_Click" ToolTip="Copy (Ctrl+C)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE8C8;" />
                            <TextBlock Text="Copy" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource BarButton}" Click="Save_Click" ToolTip="Save to your screenshots folder (Ctrl+S)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE74E;" />
                            <TextBlock Text="Save" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource BarButton}" Click="SaveAs_Click" ToolTip="Save as (Ctrl+Shift+S)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE792;" />
                            <TextBlock Text="Save as" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="SelectTool" Style="{StaticResource ToolButton}" ToolTip="Move around (V)" IsChecked="True" Checked="Tool_Checked">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE7C9;" />
                    </RadioButton>
                    <RadioButton x:Name="PenTool" Style="{StaticResource ToolButton}" ToolTip="Pen (P)" Checked="Tool_Checked">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE76D;" />
                    </RadioButton>
                    <RadioButton x:Name="HighlighterTool" Style="{StaticResource ToolButton}" ToolTip="Highlighter (H)" Checked="Tool_Checked">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE7E6;" />
                    </RadioButton>
                    <RadioButton x:Name="RectangleTool" Style="{StaticResource ToolButton}" ToolTip="Rectangle (R) &#x2014; hold Shift for a square" Checked="Tool_Checked">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE739;" />
                    </RadioButton>
                    <RadioButton x:Name="EllipseTool" Style="{StaticResource ToolButton}" ToolTip="Ellipse (E) &#x2014; hold Shift for a circle" Checked="Tool_Checked">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xEA3A;" />
                    </RadioButton>
                    <RadioButton x:Name="ArrowTool" Style="{StaticResource ToolButton}" ToolTip="Arrow (A)" Checked="Tool_Checked">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE72A;" RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform>
                                <RotateTransform Angle="-45" />
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </RadioButton>

                    <Rectangle Style="{StaticResource BarDivider}" />

                    <Button x:Name="ColorButton" Style="{StaticResource BarButton}" Click="ColorButton_Click" ToolTip="Color">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="ColorDot" Width="18" Height="18" StrokeThickness="1"
                                     Stroke="{DynamicResource ControlStrongStrokeColorDefaultBrush}" />
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE70D;" FontSize="10" Margin="6,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="SizeButton" Style="{StaticResource BarButton}" Click="SizeButton_Click" ToolTip="Size">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="18" Height="18">
                                <Ellipse x:Name="SizeDot" Fill="{DynamicResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE70D;" FontSize="10" Margin="6,0,0,0" />
                        </StackPanel>
                    </Button>

                    <Rectangle Style="{StaticResource BarDivider}" />

                    <Button x:Name="UndoButton" Style="{StaticResource BarButton}" Click="Undo_Click" ToolTip="Undo (Ctrl+Z)">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE7A7;" />
                    </Button>
                    <Button x:Name="RedoButton" Style="{StaticResource BarButton}" Click="Redo_Click" ToolTip="Redo (Ctrl+Y)">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE7A6;" />
                    </Button>
                    <Button x:Name="ClearButton" Style="{StaticResource BarButton}" Click="Clear_Click" ToolTip="Erase all markup">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE75C;" />
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Image -->
        <ScrollViewer x:Name="Scroller" Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      Background="{DynamicResource LayerOnMicaBaseAltFillColorSecondaryBrush}" Focusable="False">
            <Grid x:Name="ZoomHost" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid.LayoutTransform>
                    <ScaleTransform x:Name="Zoom" />
                </Grid.LayoutTransform>
                <Grid x:Name="Surface">
                    <Grid.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.25" />
                    </Grid.Effect>
                    <Image x:Name="Photo" Stretch="Fill" />
                </Grid>
                <Canvas x:Name="Ink" Background="Transparent" ClipToBounds="True"
                        MouseLeftButtonDown="Ink_MouseDown" MouseMove="Ink_MouseMove" MouseLeftButtonUp="Ink_MouseUp" />
            </Grid>
        </ScrollViewer>

        <!-- Status bar -->
        <Border Grid.Row="2" Padding="14,4,10,4" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource BarButton}" Height="28" MinWidth="28" Click="ZoomOut_Click" ToolTip="Zoom out (Ctrl+-)">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE71F;" FontSize="14" />
                    </Button>
                    <TextBlock x:Name="ZoomText" Width="48" TextAlignment="Center" VerticalAlignment="Center" FontSize="12" />
                    <Button Style="{StaticResource BarButton}" Height="28" MinWidth="28" Click="ZoomIn_Click" ToolTip="Zoom in (Ctrl+=)">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE8A3;" FontSize="14" />
                    </Button>
                    <Button Style="{StaticResource BarButton}" Height="28" MinWidth="28" Click="Fit_Click" ToolTip="Fit to window (Ctrl+0)">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE9A6;" FontSize="14" />
                    </Button>
                    <Button Style="{StaticResource BarButton}" Height="28" MinWidth="28" Click="ActualSize_Click" ToolTip="Actual size (Ctrl+1)">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE71E;" FontSize="14" />
                    </Button>
                </StackPanel>
                <TextBlock x:Name="SizeText" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" FontSize="12" Margin="16,0,0,0" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <Button x:Name="ShowFileButton" Style="{StaticResource BarButton}" Height="28" Visibility="Collapsed" Margin="8,0,0,0"
                        Click="ShowFile_Click" HorizontalAlignment="Left">
                    <TextBlock Text="Show in folder" FontSize="12" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                </Button>
            </DockPanel>
        </Border>

        <Popup x:Name="ColorPopup" PlacementTarget="{Binding ElementName=ColorButton}" Placement="Bottom"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" Closed="Popup_Closed">
            <Border Style="{StaticResource Flyout}">
                <ContentControl x:Name="ColorHost" />
            </Border>
        </Popup>

        <Popup x:Name="SizePopup" PlacementTarget="{Binding ElementName=SizeButton}" Placement="Bottom"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" Closed="Popup_Closed">
            <Border Style="{StaticResource Flyout}" Width="280">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock x:Name="SizeValue" DockPanel.Dock="Right" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="SizeTitle" Text="Size" FontWeight="SemiBold" />
                    </DockPanel>
                    <Slider x:Name="SizeSlider" Minimum="1" Maximum="48" IsSnapToTickEnabled="True" TickFrequency="1"
                            SmallChange="1" LargeChange="4" ValueChanged="SizeSlider_ValueChanged" />
                    <StackPanel x:Name="SizePresets" Orientation="Horizontal" Margin="0,10,0,0" />
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
