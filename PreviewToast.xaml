<Window x:Class="Shotto.PreviewToast"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Shotto" Width="360" Height="316"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" UseLayoutRounding="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0,0,0,1" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Border BorderBrush="{DynamicResource SurfaceStrokeColorFlyoutBrush}" BorderThickness="1">
        <Grid Margin="16,10,12,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource SubtleButton}" Width="32" Height="32" MinWidth="32"
                        ToolTip="Dismiss" Click="Dismiss_Click">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE711;" FontSize="12" />
                </Button>
                <Image x:Name="AppIcon" Width="16" Height="16" VerticalAlignment="Center" />
                <TextBlock Text="Shotto" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </DockPanel>

            <Button Grid.Row="1" Margin="0,6,4,0" Cursor="Hand" ToolTip="Edit" Click="Edit_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Frame" CornerRadius="4" BorderThickness="1" ClipToBounds="True"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                Background="{DynamicResource LayerFillColorDefaultBrush}">
                            <Image x:Name="Thumb" Source="{Binding}" Stretch="Uniform" Margin="2"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <StackPanel Grid.Row="2" Margin="0,12,4,0">
                <TextBlock x:Name="Headline" Text="Copied to clipboard" FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock x:Name="Detail" Text="Select the preview to mark up and share." FontSize="12" Margin="0,2,0,0"
                           TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
                <Button Style="{StaticResource AccentButtonStyle}" Click="Edit_Click" MinWidth="96">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE70F;" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="Edit" />
                    </StackPanel>
                </Button>
                <Button Margin="8,0,0,0" Click="Save_Click" MinWidth="96" ToolTip="Save to your screenshots folder">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE74E;" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="Save" />
                    </StackPanel>
                </Button>
                <Button Margin="8,0,0,0" Click="SaveAs_Click" MinWidth="96" ToolTip="Choose where to save">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE792;" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="Save as" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
