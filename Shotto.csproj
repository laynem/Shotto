<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>Shotto</AssemblyName>
    <RootNamespace>Shotto</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Shotto.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Product>Shotto</Product>
    <!-- WPF0001: ThemeMode (Fluent) is flagged experimental. WFO0003: DPI awareness must stay in the manifest for WPF. -->
    <NoWarn>$(NoWarn);WPF0001;WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\Shotto.ico" />
  </ItemGroup>

</Project>
