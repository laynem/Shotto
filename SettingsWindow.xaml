<Window x:Class="Shotto.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Shotto" Width="760" Height="860" MinWidth="520" MinHeight="480"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="CaptureTile" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="96" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="8" />
        </Style>
        <Style x:Key="CaptureTileAccent" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
            <Setter Property="Height" Value="96" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="8" />
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="40,28,40,40" MaxWidth="1000">

            <StackPanel Orientation="Horizontal">
                <Image x:Name="Logo" Width="44" Height="44" VerticalAlignment="Center" />
                <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Shotto" FontSize="28" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display, Segoe UI"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="Screenshots straight to your clipboard." FontSize="14"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </StackPanel>

            <!-- Capture now -->
            <TextBlock Style="{StaticResource SectionHeader}" Text="Capture" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource CaptureTileAccent}" Click="CaptureRegion_Click">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE7A8;" FontSize="24" />
                        <TextBlock Text="Area" Margin="0,10,0,0" HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="2" Style="{StaticResource CaptureTile}" Click="CaptureMonitor_Click">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE7F4;" FontSize="24" />
                        <TextBlock Text="This screen" Margin="0,10,0,0" HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="4" Style="{StaticResource CaptureTile}" Click="CaptureAll_Click">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE740;" FontSize="24" />
                        <TextBlock Text="All screens" Margin="0,10,0,0" HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Shortcuts -->
            <TextBlock Style="{StaticResource SectionHeader}" Text="Keyboard shortcuts" />
            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <Button x:Name="RegionKey" DockPanel.Dock="Right" Tag="Region" Click="Shortcut_Click" VerticalAlignment="Center" />
                    <TextBlock Style="{StaticResource CardIcon}" Text="&#xE7A8;" />
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Style="{StaticResource CardTitle}" Text="Capture an area" />
                        <TextBlock Style="{StaticResource CardDescription}" Text="Drag to select part of the screen, or click to capture the whole screen." />
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <Button x:Name="MonitorKey" DockPanel.Dock="Right" Tag="Monitor" Click="Shortcut_Click" VerticalAlignment="Center" />
                    <TextBlock Style="{StaticResource CardIcon}" Text="&#xE7F4;" />
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Style="{StaticResource CardTitle}" Text="Capture this screen" />
                        <TextBlock Style="{StaticResource CardDescription}" Text="The whole monitor your mouse pointer is on." />
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <Button x:Name="AllScreensKey" DockPanel.Dock="Right" Tag="AllScreens" Click="Shortcut_Click" VerticalAlignment="Center" />
                    <TextBlock Style="{StaticResource CardIcon}" Text="&#xE740;" />
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Style="{StaticResource CardTitle}" Text="Capture all screens" />
                        <TextBlock Style="{StaticResource CardDescription}" Text="Every monitor in one image." />
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <CheckBox x:Name="PrintScreenToggle" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" Click="PrintScreen_Click" />
                    <TextBlock Style="{StaticResource CardIcon}" Text="&#xE765;" />
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Style="{StaticResource CardTitle}" Text="Use Print Screen for Shotto" />
                        <TextBlock Style="{StaticResource CardDescription}" Text="Turns off the Windows setting that opens Snipping Tool, so Print Screen never opens it, even when Shotto is closed. Turning this off puts the Windows setting back." />
                    </StackPanel>
                </DockPanel>
            </Border>
            <DockPanel Margin="2,4,0,0">
                <Button DockPanel.Dock="Right" Content="Restore defaults" Click="ResetShortcuts_Click" />
                <TextBlock x:Name="ShortcutMessage" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12" Margin="0,0,12,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="Select a shortcut to change it." />
            </DockPanel>

            <!-- After capture -->
            <TextBlock Style="{StaticResource SectionHeader}" Text="After capturing" />
            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <CheckBox x:Name="CopyToggle" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" Click="Toggle_Click" />
                    <TextBlock Style="{StaticResource CardIcon}" Text="&#xE8C8;" />
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Style="{StaticResource CardTitle}" Text="Copy to clipboard" />
                        <TextBlock Style="{StaticResource CardDescription}" Text="Paste your screenshot anywhere right away." />
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <CheckBox x:Name="PreviewToggle" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" Click="Toggle_Click" />
                    <TextBlock Style="{StaticResource CardIcon}" Text="&#xE8A1;" />
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Style="{StaticResource CardTitle}" Text="Show a preview" />
                        <TextBlock Style="{StaticResource CardDescription}" Text="A thumbnail pops up in the corner. Select it to edit, or save from there." />
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <CheckBox x:Name="EditorToggle" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" Click="Toggle_Click" />
                    <TextBlock Style="{StaticResource CardIcon}" Text="&#xE70F;" />
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Style="{StaticResource CardTitle}" Text="Open the editor" />
                        <TextBlock Style="{StaticResource CardDescription}" Text="Go straight to drawing, highlighting and shapes after every capture." />
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <CheckBox x:Name="AutoSaveToggle" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" Click="Toggle_Click" />
                    <TextBlock Style="{StaticResource CardIcon}" Text="&#xE74E;" />
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Style="{StaticResource CardTitle}" Text="Save automatically" />
                        <TextBlock Style="{StaticResource CardDescription}" Text="Also keep a file of every capture in your save folder." />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Saving -->
            <TextBlock Style="{StaticResource SectionHeader}" Text="Saving" />
            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Change folder" Click="ChangeFolder_Click" />
                        <Button Margin="8,0,0,0" ToolTip="Open folder" Click="OpenFolder_Click" Padding="10,6">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE838;" />
                        </Button>
                    </StackPanel>
                    <TextBlock Style="{StaticResource CardIcon}" Text="&#xE8B7;" />
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Style="{StaticResource CardTitle}" Text="Save folder" />
                        <TextBlock x:Name="FolderText" Style="{StaticResource CardDescription}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <ComboBox x:Name="FormatBox" DockPanel.Dock="Right" Width="120" VerticalAlignment="Center" SelectionChanged="Format_Changed">
                        <ComboBoxItem Content="PNG" Tag="png" />
                        <ComboBoxItem Content="JPG" Tag="jpg" />
                    </ComboBox>
                    <TextBlock Style="{StaticResource CardIcon}" Text="&#xEB9F;" />
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Style="{StaticResource CardTitle}" Text="File type" />
                        <TextBlock Style="{StaticResource CardDescription}" Text="PNG keeps every pixel sharp. JPG makes smaller files." />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Startup -->
            <TextBlock Style="{StaticResource SectionHeader}" Text="Startup" />
            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <CheckBox x:Name="StartupToggle" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" Click="Startup_Click" />
                    <TextBlock Style="{StaticResource CardIcon}" Text="&#xE7E8;" />
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Style="{StaticResource CardTitle}" Text="Launch when Windows starts" />
                        <TextBlock Style="{StaticResource CardDescription}" Text="Your shortcuts work as soon as you sign in." />
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <CheckBox x:Name="SilentToggle" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" Click="Startup_Click" />
                    <TextBlock Style="{StaticResource CardIcon}" Text="&#xE8C9;" />
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Style="{StaticResource CardTitle}" Text="Start silently" />
                        <TextBlock Style="{StaticResource CardDescription}" Text="Start in the notification area without opening this window." />
                    </StackPanel>
                </DockPanel>
            </Border>

            <DockPanel Margin="2,24,0,0">
                <Button DockPanel.Dock="Right" Content="Exit Shotto" Click="Exit_Click" />
                <TextBlock x:Name="VersionText" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Text="Closing this window keeps Shotto running in the notification area." TextWrapping="Wrap" Margin="0,0,12,0" />
            </DockPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
